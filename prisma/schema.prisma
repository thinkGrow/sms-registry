// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Programme {
  id        String   @id @default(cuid())
  name      String   @unique
  feeAmount Decimal  @db.Decimal(10, 2)

  // Date the programme's fee is due each cycle. Nullable: a programme with no
  // due date set never flags its students as overdue, rather than defaulting
  // to "always overdue" or "never overdue" silently.
  feeDueDate DateTime? @db.Date

  students    Student[]
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

model Student {
  id          String   @id @default(cuid())
  studentId   String   @unique // e.g. SMS-2025-0001, generated in application logic
  fullName    String
  email       String   @unique
  dateOfBirth DateTime @db.Date

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  // Year of study (1st/2nd/3rd...), not intake/cohort year. Stored as a plain,
  // staff-editable value rather than derived from enrolment date, because a
  // retake can put a student in the same year across two academic sessions.
  academicYear Int

  status EnrolmentStatus @default(ENROLLED)

  // Optional per-student fee override (e.g. discount, financial aid, scholarship)
  // for cases where the standard programme fee doesn't apply. Deliberately kept
  // as a single field rather than a full financial-aid/scholarship subsystem,
  // which is out of scope for this assessment - see README for reasoning.
  feeOverride Decimal? @db.Decimal(10, 2)

  payments    Payment[]
  submissions Submission[]
  grades      Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())

  // Auto-generated internal transaction reference, e.g. PMT-2026-000001.
  // This app doesn't process payments itself (no gateway/bank integration),
  // so there's no external reference to capture; generating our own avoids
  // relying on staff-entered values for uniqueness.
  referenceNumber String @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  amount Decimal  @db.Decimal(10, 2)
  paidAt DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assessment {
  id    String @id @default(cuid())
  title String

  // Plain descriptive label (e.g. "Data Structures"), not a separate Module
  // entity. See README Known Limitations: this app doesn't model per-module
  // student registration.
  module String

  // Restricts submission eligibility to students in this programme. Deliberate
  // simplification: assumes every student in the programme takes every module
  // under it, doesn't account for electives or individual module registration.
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  // Full date and time, unlike date-only fields elsewhere, since "late" is
  // determined precisely against a cutoff time, not just a calendar day.
  deadline DateTime

  submissions Submission[]
  grades      Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubmissionFileType {
  PDF
  DOCX
}

model Submission {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  fileUrl  String
  fileName String
  fileType SubmissionFileType

  // createdAt = time of the first submission. updatedAt = time of the most
  // recent resubmission. "Late" is computed as updatedAt > assessment.deadline
  // at query time, not stored, same principle as the overdue-fee flag.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One submission per student per assessment; a resubmission updates this row
  // rather than creating a new one, so no history of earlier attempts is kept.
  @@unique([studentId, assessmentId])
}

model Grade {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // 0-100, half-point increments allowed. Decimal rather than Int or Float so
  // the classification thresholds below compare exactly, no rounding risk.
  score Decimal @db.Decimal(4, 1)

  // Classification (Fail < 40, Pass >= 40, Merit >= 60, Distinction >= 70) is
  // computed from score at read time, not stored, same principle as overdue
  // and late flags elsewhere.

  // Publish/withhold is per grade (per student, per assessment), not a single
  // switch covering a student's whole marksheet at once, so staff can publish
  // results assessment by assessment as grading finishes.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, assessmentId])
}
